---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import Search from '@astrojs/starlight/components/Search.astro';

const { sidebar } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;

const sections = sidebar.filter((item: any) => item.type === 'group');

function firstLink(group: any): string {
  for (const e of group.entries ?? []) {
    if (e.type === 'link') return e.href;
    if (e.type === 'group') {
      const h = firstLink(e);
      if (h !== '/') return h;
    }
  }
  return '/';
}

function sectionSegment(group: any): string {
  const href = firstLink(group);
  return href.split('/').filter(Boolean)[0] ?? '';
}

function sectionRoot(group: any): string {
  const seg = sectionSegment(group);
  return seg ? `/${seg}/` : firstLink(group);
}

const active =
  sections.find((s: any) => {
    const seg = sectionSegment(s);
    return seg && pathname.includes(`/${seg}/`);
  }) ?? sections[0];

function stripIndex(entries: any[], rootHref: string): any[] {
  return entries
    .filter((e) => !(e.type === 'link' && (e.href === rootHref || e.href === rootHref.replace(/\/$/, ''))))
    .map((e) => (e.type === 'group' ? { ...e, entries: stripIndex(e.entries ?? [], rootHref) } : e));
}

const activeSublist = active ? stripIndex(active.entries, sectionRoot(active)) : sidebar;
---

<div class="sidebar-search">
  <Search {...Astro.props} />
</div>

{sections.length > 1 && (
  <nav class="section-switcher" aria-label="Sections">
    {sections.map((s: any) => (
      <a
        href={sectionRoot(s)}
        class:list={['section-tab', { active: s === active }]}
      >
        {s.label}
      </a>
    ))}
  </nav>
)}

<SidebarPersister>
  <SidebarSublist sublist={activeSublist} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .sidebar-search {
    padding: 0 var(--sl-sidebar-pad-x) 0.75rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
    margin-bottom: 0.5rem;
  }
  .section-switcher {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0 var(--sl-sidebar-pad-x) 1rem;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
  }
  :root[data-theme='light'] .section-switcher {
    background: var(--sl-color-gray-7);
  }
  .section-tab {
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--sl-text-sm);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .section-tab:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .section-tab.active {
    background: var(--sl-color-bg);
    color: var(--sl-color-text-accent, var(--sl-color-white));
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
  }
</style>
