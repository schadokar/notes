---
// src/components/header/ZenModeHeader.astro
// Custom header with zen mode button
// Based on Starlight's default header but with zen mode toggle added

import SiteTitle from 'virtual:starlight/components/SiteTitle';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ZenModeToggle from '../ZenModeToggle.astro';
---

<div class="header">
  <div class="sl-flex items-center justify-between gap-md">
    <div class="sl-flex items-center gap-md">
      <SiteTitle {...Astro.props} />
    </div>
    <div class="sl-flex items-center justify-end gap-md">
      <LanguageSelect {...Astro.props} />
      <Search {...Astro.props} />
      <SocialIcons {...Astro.props} />
      <ZenModeToggle />
    </div>
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
  }
</style>
